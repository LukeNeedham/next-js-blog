{
  "name": "next-js-blog",
  "version": "1.1.0",
  "description": "The build step of a Next.js blog whose articles are markdown in a content repo: download, validate, render to HTML.",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
